# Example keystore configuration for release signing.
# 1. Generate a keystore using the keytool command (see PLAY_STORE_GUIDE.md).
# 2. Copy this file to "keystore.properties" (do not commit it to git).
# 3. Fill in your actual keystore details below.

storeFile=release.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
